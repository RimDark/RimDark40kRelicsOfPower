<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Gene-Crypt Catalyst -->
  <ThingDef>
    <defName>Relics40k_GeneCryptCatalyst</defName>
    <label>gene-crypt catalyst</label>
    <thingClass>ThingWithComps</thingClass>
    <description>A sealed stasis phial recovered from one of the Emperor's gene-crypts beneath the Himalazian range. Within swirls a refinement serum from the Unification Wars: the intermediate step between the crude Thunder Warrior template and the finished Astartes design, abandoned once Terra was won and its first sons were no longer wanted.\n\nWhen ingested by a Thunder Warrior, the catalyst rewrites the failing proto-organs into their perfected Astartes forms and burns the Furybound sequence out of the brainstem. The coarser gene-lines survive the process untouched - the subject does not become a true Firstborn, but a Thunderborn Astartes: stable, enduring, and no longer dying by design.\n\nThe rewriting takes ten days of total unconsciousness. Only a Thunder Warrior's biology can survive it.</description>
    <graphicData>
      <texPath>Things/Item/GeneseedVial/BEWH_GeneseedVial_Firstborn</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9, 0.9)</drawSize>
    </graphicData>
    <category>Item</category>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.6</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <MarketValue>30000</MarketValue>
    </statBases>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <rotatable>false</rotatable>
    <drawGUIOverlay>false</drawGUIOverlay>
    <pathCost>14</pathCost>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Undergo gene-crypt catalysis</useLabel>
        <useDuration>600</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="Relics40k.CompProperties_UseEffectGeneCryptCatalyst"/>
      <li Class="CompProperties_UseEffectDestroySelf"/>
      <li Class="CompProperties_InspectString">
        <inspectString>Only a thunder warrior can use this.\nSelect one and right-click the catalyst.</inspectString>
      </li>
    </comps>
    <modExtensions>
      <li Class="Relics40k.DefModExtension_GeneCryptCatalyst">
        <requiredGenes>
          <li>BEWH_ProtoOssmodula</li>
          <li>BEWH_Musculeator</li>
          <li>BEWH_Mentanifex</li>
          <li>BEWH_Vigoranis</li>
          <li>BEWH_Hyperanatomica</li>
          <li>BEWH_Furybound</li>
        </requiredGenes>
        <genesToRemove>
          <li>BEWH_ProtoOssmodula</li>
          <li>BEWH_Musculeator</li>
          <li>BEWH_Furybound</li>
        </genesToRemove>
        <genesToAdd>
          <li>BEWH_SecondaryHeart</li>
          <li>BEWH_Ossmodula</li>
          <li>BEWH_Biscopea</li>
          <li>BEWH_Haemastamen</li>
          <li>BEWH_LarramansOrgan</li>
          <li>BEWH_CatalepseanNode</li>
          <li>BEWH_Preomnor</li>
          <li>BEWH_Omophagea</li>
          <li>BEWH_MultiLung</li>
          <li>BEWH_Occulobe</li>
          <li>BEWH_LymansEar</li>
          <li>BEWH_SusAnMembrane</li>
          <li>BEWH_Melanochrome</li>
          <li>BEWH_OoliticKidney</li>
          <li>BEWH_Neuroglottis</li>
          <li>BEWH_Mucranoid</li>
          <li>BEWH_BetchersGland</li>
          <li>BEWH_ProgenoidGlands</li>
          <li>BEWH_BlackCarapace</li>
        </genesToAdd>
        <newXenotype>BEWH_SpaceMarine</newXenotype>
        <newXenotypeName>Thunderborn Astartes</newXenotypeName>
        <newXenotypeIcon>BEWH_AstartesIcon</newXenotypeIcon>
        <comaHediff>Relics40k_GeneCryptComa</comaHediff>
        <frozenInstabilityHediff>Relics40k_ThunderbornInstability</frozenInstabilityHediff>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
